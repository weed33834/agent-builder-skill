# ============================================================
# Universal Agent Builder - Environment Variable Configuration
# ============================================================

# --- LLM Configuration ---
# Provider: openai | anthropic | deepseek | ollama
LLM_PROVIDER=openai

# Model name
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku
# DeepSeek: deepseek-chat
# Ollama: qwen2.5:7b, llama3.1:8b
LLM_MODEL=gpt-4o

# API Key
LLM_API_KEY=your-api-key-here

# Custom API base URL (optional, for third-party services compatible with OpenAI format)
LLM_API_BASE=

# Model parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- LangSmith Configuration (optional, for debugging) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-builder

# --- Tool Configuration ---
MAX_TOOL_CALLS=10
TOOL_TIMEOUT=30

# --- Memory Configuration ---
MEMORY_TYPE=buffer
MEMORY_MAX_MESSAGES=50
