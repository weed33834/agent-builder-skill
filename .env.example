# ============================================================
# MindMirror Configuration
# Copy this file to ".env" and fill in actual values.
# All settings map 1:1 to Settings fields in app/core/config.py.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=MindMirror
ENV=local              # local | staging | production
DEBUG=true             # set false in production

# ── Database ─────────────────────────────────────────────────
# Local SQLite (default). Switch to Postgres for production by
# changing the connection string below.
#   Postgres example:
#     postgresql+asyncpg://user:password@host:5432/mindmirror
DATABASE_URL=sqlite+aiosqlite:///./data/db/mindmirror.db

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowlist of origins.
# Add your production domain and any mini-program servicemock URLs.
#   Production example:
#     https://mindmirror.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Authentication ───────────────────────────────────────────
# Provider modes:
#   local  — random token, development only (no real auth)
#   jwt    — standard JWT bearer, suitable for web/production
#   wx     — WeChat Mini Program login (wx.login → code2session)
AUTH_SECRET=change-me-in-production
AUTH_PROVIDER=local
