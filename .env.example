# ============================================================
# Universal Agent Builder - Environment Variable Configuration
# 完整配置项（与 templates/backend/app/l10_infra/config.py 对齐）
# ============================================================

# --- 应用信息 ---
APP_NAME=Agent Builder
APP_VERSION=0.5.2
DEBUG=false

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- LLM Configuration ---
# Provider: openai | anthropic | deepseek | qwen | kimi | glm | gemini | ollama
LLM_PROVIDER=openai

# Model name
# OpenAI: gpt-4o, gpt-4o-mini, o3-mini
# Anthropic: claude-sonnet-4, claude-haiku-3.5
# DeepSeek: deepseek-chat, deepseek-v3
# Ollama: qwen2.5:7b, llama3.1:8b
LLM_MODEL=gpt-4o

# API Key
LLM_API_KEY=your-api-key-here

# Custom API base URL (optional, for third-party services compatible with OpenAI format)
LLM_API_BASE=

# Model parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- L2: Retry / fallback (deep-spec 06 / 25) ---
LLM_RETRY_COUNT=3
LLM_RETRY_DELAY=1.0
MODEL_FALLBACK_ENABLED=false
# FALLBACK_MODELS=[{"provider":"deepseek","model":"deepseek-chat"}]

# --- L5: Tool Configuration ---
MAX_TOOL_CALLS=10
TOOL_TIMEOUT=30

# --- L6: Memory / RAG (deep-spec 05 / 20-D) ---
MEMORY_TYPE=buffer
MEMORY_MAX_MESSAGES=50
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_COLLECTION=knowledge_base
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
SUMMARY_THRESHOLD=40

# --- L7: Orchestration ---
MAX_SUBTASKS=5
ORCHESTRATOR_TIMEOUT=120
APP_PUBLIC_URL=http://localhost:8000
# A2A_BEARER_TOKENS={"agent1":"token1"}

# --- L4: Checkpoint / persistence ---
CHECKPOINT_TYPE=memory   # memory | sqlite | postgres
CHECKPOINT_DB_PATH=./agent_checkpoints.db

# --- L8: API security (deep-spec 13 / 27) ---
# 启用则所有 /api 请求需带 Authorization: Bearer <API_KEY>
API_KEY=
# 限流（deep-spec 25 E.2）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=5.0
RATE_LIMIT_BURST=10
RATE_LIMIT=60

# --- L10: Observability (deep-spec 12 / 25) ---
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
TRACING_ENABLED=false
OTLP_ENDPOINT=

# --- 成本计费预算（deep-spec 23，也可经 /api/admin/usage/budget 设置） ---
USAGE_MONTHLY_BUDGET_USD=100.0

# --- LangSmith Configuration (optional, for debugging) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-builder

# --- Optional external services ---
REDIS_URL=
DATABASE_URL=
