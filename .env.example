# ============================================================
# 万能 Agent 构建器 - 环境变量配置
# ============================================================

# --- LLM 配置 ---
# 提供商: openai | anthropic | deepseek | ollama
LLM_PROVIDER=openai

# 模型名称
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku
# DeepSeek: deepseek-chat
# Ollama: qwen2.5:7b, llama3.1:8b
LLM_MODEL=gpt-4o

# API Key
LLM_API_KEY=your-api-key-here

# 自定义 API 地址（可选，用于兼容 OpenAI 格式的第三方服务）
LLM_API_BASE=

# 模型参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# --- LangSmith 配置（可选，用于调试） ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-builder

# --- 工具配置 ---
MAX_TOOL_CALLS=10
TOOL_TIMEOUT=30

# --- 记忆配置 ---
MEMORY_TYPE=buffer
MEMORY_MAX_MESSAGES=50