# 心镜 MindMirror 配置示例 —— 复制为 .env 后填入实际值

# 应用基本信息
APP_NAME=心镜 MindMirror
ENV=local            # local | staging | production
DEBUG=true           # 生产环境设 false

# 数据库 —— 本地 SQLite,上线换 Postgres 改此串即可
# Postgres 示例:postgresql+asyncpg://user:pass@host:5432/mindmirror
DATABASE_URL=sqlite+aiosqlite:///./data/db/mindmirror.db

# CORS 白名单(逗号分隔) —— 上线加域名,小程序加 servicemock
# 生产示例:https://mindmirror.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 认证 —— 本地用简单 token,上线换 JWT/wx
# AUTH_PROVIDER 可选:local(开发用)| jwt(标准)| wx(微信 wx.login)
AUTH_SECRET=change-me-in-production
AUTH_PROVIDER=local
